package(default_visibility = ["//visibility:public"])

load("@rules_lean//lean:defs.bzl", "lean_assurance_test", "lean_library")
load("//:assurance.bzl", "TLS13_LEAN_ALLOWED_AXIOMS")
load("//:assurance_types.bzl", "TLS13_PRINCIPAL_TYPES")

# Pure-Lean TLS 1.3 key-schedule specification/refinement and X.509 stack,
# built on the HaclStar crypto bindings. The record layer, handshake codecs,
# and client/server state machines live in //Tls.
lean_library(
    name = "tls13",
    srcs = [
        "KeySchedule.lean",
        "KeySchedule/Refinement.lean",
        "KeySchedule/Spec.lean",
        "X509.lean",
        "X509/Certificate.lean",
        "X509/ChannelBinding.lean",
        "X509/Chain.lean",
        "X509/DER.lean",
        "X509/Hostname.lean",
        "X509/OID.lean",
        "X509/PEM.lean",
        "X509/RSA.lean",
        "X509/Signature.lean",
        "X509/Time.lean",
    ],
    deps = ["//HaclStar:haclstar"],
)

# Compile-time audit of the key-schedule and X.509 / DER tiers. The principal
# theorems are (a) the RFC 8446 §7.1 refinement chain — the derivation tree
# transcribed as data, the `HkdfLabel` wire image byte for byte, and each
# implementation function shown to compute its specification counterpart for
# *any* HKDF the HACL\* bindings implement; (b) the retention chain that
# makes certificate verification mean anything: the DER decoder hands back the
# exact substring it consumed, a decoded `TBSCertificate` retains those bytes,
# and issuer vetting verified the signature over exactly them; and (c) the
# successful-validation policy that a present TLS leaf KeyUsage permits digital
# signatures.
#
# Exact policy: every theorem statement is pinned in //:assurance_types.bzl,
# and this library's own trust surface is pinned to nothing — no unsafe, no
# partial, no opaque, no `@[implemented_by]`, no `@[extern]` anywhere under
# `TLS13`, so native code appearing outside the FFI package fails the build.
# The imported `HaclStar` modules are declared unaudited here because
# //HaclStar:haclstar_assurance owns that prefix and pins its extern boundary.
lean_assurance_test(
    name = "tls13_assurance",
    allowed_axioms = TLS13_LEAN_ALLOWED_AXIOMS,
    module_prefixes = ["TLS13"],
    policy_mode = "exact",
    unaudited_module_prefixes = ["HaclStar"],
    principal_theorems = [
        # Key schedule: the RFC 8446 §7.1 derivation tree, as data.
        "TLS13.KeySchedule.Spec.Label.text_rfc8446",
        "TLS13.KeySchedule.Spec.Derived.tree_rfc8446",
        "TLS13.KeySchedule.Spec.HkdfLabel.encode_bytes",
        "TLS13.KeySchedule.Spec.emptyContext_rfc8446",
        # Key schedule: the implementation refines it.
        "TLS13.KeySchedule.hkdfLabel_encode",
        "TLS13.KeySchedule.hkdfLabel_bytes",
        "TLS13.KeySchedule.expandLabel_spec",
        "TLS13.KeySchedule.deriveSecret_spec",
        "TLS13.KeySchedule.earlySecret_spec",
        "TLS13.KeySchedule.handshakeSecret_spec",
        "TLS13.KeySchedule.masterSecret_spec",
        "TLS13.KeySchedule.derived_spec",
        # DER: what the decoder accepted, byte for byte.
        "TLS13.X509.DER.decode_encoded",
        "TLS13.X509.DER.decode_inj",
        "TLS13.X509.DER.decode_contents",
        "TLS13.X509.DER.decode_idem",
        "TLS13.X509.DER.decode_append_ne_ok",
        "TLS13.X509.DER.Reader.readTLV_encoded",
        "TLS13.X509.DER.Reader.readLength_minimal",
        # Certificate: the retained TBS bytes are the signed bytes.
        "TLS13.X509.Certificate.decode_encoded",
        "TLS13.X509.Certificate.decode_tbs_encoded",
        # Chain: a vetted issuer link verified over exactly those bytes, and a
        # successful TLS leaf validation satisfies RFC 9846 KeyUsage policy.
        "TLS13.X509.Chain.checkIssuer_verifies",
        "TLS13.X509.Chain.validate_leaf_keyUsage",
    ],
    principal_theorem_types = TLS13_PRINCIPAL_TYPES,
    expected_unsafe_constants = [],
    expected_partial_definitions = [],
    expected_opaque_constants = [],
    expected_implemented_by = {},
    expected_extern_declarations = {},
    expected_native_targets = [
        "//HaclStar:hacl_shim",
        "//HaclStar:lean_runtime_headers",
        "@+_repo_rules+hacl//:hacl",
    ],
    deps = [":tls13"],
)
