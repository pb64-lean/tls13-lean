package(default_visibility = ["//visibility:public"])

load("@rules_lean//lean:defs.bzl", "lean_library")

# Reusable sans-I/O TLS 1.3 protocol core (record layer, handshake codecs, and
# client + server state machines) over the verified HACL* crypto and X.509 in
# this repo. Consumed by sibling clients/servers (pg-lean, grpc-lean).
lean_library(
    name = "tls",
    srcs = [
        "Record.lean",
        "Record/Laws.lean",
        "Handshake.lean",
        "Client.lean",
        "Client/Laws.lean",
        "Server.lean",
    ],
    deps = [
        "//HaclStar:haclstar",
        "//TLS13:tls13",
    ],
)
