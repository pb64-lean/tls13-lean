package(default_visibility = ["//visibility:public"])

load("@rules_lean//lean:defs.bzl", "lean_assurance_test", "lean_library")
load("//:assurance.bzl", "TLS13_LEAN_ALLOWED_AXIOMS")
load("//:assurance_types.bzl", "TLS_PRINCIPAL_TYPES")

# Reusable sans-I/O TLS 1.3 protocol core (record layer, handshake codecs, and
# client + server state machines) over the verified HACL* crypto and X.509 in
# this repo. Consumed by sibling clients/servers (pg-lean, grpc-lean).
lean_library(
    name = "tls",
    srcs = [
        "Record.lean",
        "Record/Laws.lean",
        "Handshake.lean",
        "Client.lean",
        "Client/Laws.lean",
        "Server.lean",
        "Server/Laws.lean",
    ],
    deps = [
        "//HaclStar:haclstar",
        "//TLS13:tls13",
    ],
)

# Compile-time audit of the protocol core: the headline theorems must exist, be
# theorems, match their statements pinned in //:assurance_types.bzl, and close
# over nothing beyond the three standard axioms in //:assurance.bzl; no
# constant anywhere in the scanned closure may reach `sorryAx`; and the `Tls`
# trust surface is pinned to nothing — no unsafe, no partial, no opaque, no
# `@[implemented_by]`, no `@[extern]`. The imported `TLS13` and `HaclStar`
# modules are declared unaudited here because //TLS13:tls13_assurance and
# //HaclStar:haclstar_assurance own those prefixes (the latter pins the only
# native boundary in the repo); the three targets together cover the whole
# first-party import closure, so the repository-level statement survives.
#
# `allowed_axioms` is deliberately the bare standard three. The byte
# (de)composition identities in `Tls.Record.Laws` and `Tls.Handshake` are proved
# arithmetically rather than by `bv_decide`, so no generated LRAT-certificate
# axiom (`<lemma>._native.bv_decide.ax_1_5`) exists to allow. Introducing one —
# by reaching for `bv_decide` in a proof a headline theorem depends on — fails
# this audit immediately, which is the point.
lean_assurance_test(
    name = "tls_assurance",
    allowed_axioms = TLS13_LEAN_ALLOWED_AXIOMS,
    module_prefixes = ["Tls"],
    policy_mode = "exact",
    unaudited_module_prefixes = [
        "HaclStar",
        "TLS13",
    ],
    principal_theorems = [
        # Finite executable write traces. WriteRun retains the key-schedule's
        # traffic-secret bookkeeping; AeadWriteRun records the cryptographically
        # relevant concrete `(AEAD key, nonce)` pairs. The latter's explicit
        # sufficient condition is finite-run AEAD-key distinctness.
        "Tls.Record.WriteRun.nodup",
        "Tls.Record.AeadWriteRun.nodup",
        "Tls.Client.run_nonce_nodup",
        "Tls.Client.feed_nonce_nodup",
        "Tls.Server.run_nonce_nodup",
        "Tls.Server.feed_nonce_nodup",
        "Tls.Record.nonceOf_inj",
        # Finite write traces refined by the RFC 8446 key schedule. The engines
        # prove which strictly increasing derivation histories they traverse
        # and connect that bookkeeping to the actual AEAD trace. Concrete
        # AEAD-key distinctness remains the explicit sufficient finite-run
        # condition for key--nonce pair distinctness.
        "Tls.Record.SpecExtends.finite_nonce_trace",
        "Tls.Client.run_epochs",
        "Tls.Client.run_nonce_trace_spec",
        "Tls.Client.feed_nonce_trace_spec",
        "Tls.Client.start_run_nonce_trace_spec",
        "Tls.Server.run_epochs",
        "Tls.Server.run_nonce_trace_spec",
        "Tls.Server.feed_nonce_trace_spec",
        "Tls.Server.start_run_nonce_trace_spec",
        "Tls.Record.TrafficKeys.nonce_inj",
        "Tls.Record.sequenceBytes_inj",
        # Record layer: framing conserves bytes, and open inverts seal.
        "Tls.Record.decodeStep_conservation",
        "Tls.Record.decodeBuffered_conservation",
        "Tls.Record.Decoder.feed_conservation",
        "Tls.Record.Decoder.feed_residual",
        "Tls.Record.Decoder.feed_append",
        "Tls.Record.maxInnerPlaintextLength_eq",
        "Tls.Record.seal_innerPlaintext_size_le",
        "Tls.Record.open_innerPlaintext_size_le",
        "Tls.Record.open_seal",
        "Tls.Record.decodeStep_seal_open",
        "Tls.Record.seal_nonce",
        # Handshake codec: a parsed ClientHello re-encodes to its own bytes, and
        # the body determines the message.
        "Tls.Handshake.parseClientHello_canonical",
        "Tls.Handshake.parseClientHello_canonical_of_offersTls13",
        "Tls.Handshake.parseClientHello_body_injective",
        "Tls.Handshake.parseExtensions_injective",
        "Tls.Handshake.decode_encoded",
        "Tls.Handshake.decode_frame",
        "Tls.Handshake.decodeOne_canonical",
        "Tls.Handshake.decode_canonical",
        "Tls.Handshake.takeMessage?_canonical",
        "Tls.Handshake.decodeOne_injective",
        "Tls.Handshake.takeMessage?_conservation",
        # Key schedule: the engines install the RFC 8446 §7.1 epochs, with the
        # RFC's parents, labels, contexts and lengths — structural refinement,
        # parametric over the opaque HKDF (see //TLS13:tls13_assurance for the
        # specification side).
        "Tls.Record.deriveTrafficKeys_spec",
        "Tls.Record.updateTrafficSecret_spec",
        "Tls.Record.TrafficKeys.update_spec",
        "Tls.Client.finishedVerifyData_spec",
        "Tls.Client.acceptServerHello_keySchedule",
        "Tls.Client.completeServerHandshake_keySchedule",
        "Tls.Client.processHandshakeBuffer_keySchedule",
        "Tls.Client.feed_keySchedule",
        "Tls.Client.acceptKeyUpdate_keySchedule",
        "Tls.Server.finishedVerifyData_spec",
        "Tls.Server.completeClientHello_keySchedule",
        "Tls.Server.acceptKeyUpdate_keySchedule",
        # State machines: the transitions that define what "connected" means.
        "Tls.Client.completeServerHandshake_verified",
        "Tls.Client.acceptServerHello_transcript",
        "Tls.Client.acceptKeyUpdate_epoch",
        "Tls.Client.acceptKeyUpdate_invalid_request_illegalParameter",
        "Tls.Client.acceptKeyUpdate_sendingKeyUpdates_le",
        "Tls.Client.acceptKeyUpdate_response_suppressed_at_limit",
        "Tls.Client.acceptKeyUpdate_response_increments",
        "Tls.Client.acceptKeyUpdate_localClosed_suppresses_response",
        "Tls.Client.sealFatalAlert_localClosed",
        "Tls.Client.sealApplication_connected",
        "Tls.Client.feed_plaintext_connected",
        "Tls.Client.run_plaintext_connected",
        "Tls.Client.closeNotify_connected",
        "Tls.Client.feedWithFailure_peerClosed_ignored",
        "Tls.Client.State.WellFormed.noReadKeys",
        "Tls.Client.State.WellFormed.noWriteKeys",
        "Tls.Client.run_wellFormed",
        "Tls.Server.acceptClientFinished_verified",
        "Tls.Server.sendHelloRetryRequest_messageHash",
        "Tls.Server.acceptKeyUpdate_epoch",
        "Tls.Server.acceptKeyUpdate_invalid_request",
        "Tls.Server.acceptKeyUpdate_sendingKeyUpdates_le",
        "Tls.Server.acceptKeyUpdate_at_sending_limit",
        "Tls.Server.acceptKeyUpdate_response_increments",
        "Tls.Server.acceptKeyUpdate_localClosed_suppresses_response",
        "Tls.Server.sealFatalAlert_localClosed",
        "Tls.Server.checkRetryClientHello_body_eq",
        "Tls.Server.sealApplication_connected",
        "Tls.Server.feed_plaintext_connected",
        "Tls.Server.run_plaintext_connected",
        "Tls.Server.State.WellFormed.writeKeys",
        "Tls.Server.State.WellFormed.noReadKeys",
        "Tls.Server.State.WellFormed.noWriteKeys",
        "Tls.Server.closeNotify_connected",
        "Tls.Server.feedWithFailure_peerClosed_ignored",
        "Tls.Server.run_wellFormed",
    ],
    principal_theorem_types = TLS_PRINCIPAL_TYPES,
    expected_unsafe_constants = [],
    expected_partial_definitions = [],
    expected_opaque_constants = [],
    expected_implemented_by = {},
    expected_extern_declarations = {},
    expected_native_targets = [
        "//HaclStar:hacl_shim",
        "//HaclStar:lean_runtime_headers",
        "@+_repo_rules+hacl//:hacl",
    ],
    deps = [":tls"],
)
