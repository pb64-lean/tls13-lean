package(default_visibility = ["//visibility:public"])

load("@rules_lean//lean:defs.bzl", "lean_assurance_test", "lean_library")

# Reusable sans-I/O TLS 1.3 protocol core (record layer, handshake codecs, and
# client + server state machines) over the verified HACL* crypto and X.509 in
# this repo. Consumed by sibling clients/servers (pg-lean, grpc-lean).
lean_library(
    name = "tls",
    srcs = [
        "Record.lean",
        "Record/Laws.lean",
        "Handshake.lean",
        "Client.lean",
        "Client/Laws.lean",
        "Server.lean",
        "Server/Laws.lean",
    ],
    deps = [
        "//HaclStar:haclstar",
        "//TLS13:tls13",
    ],
)

# Compile-time audit of the protocol core: the headline theorems must exist, be
# theorems, and close over nothing beyond the three standard axioms; no constant
# anywhere in the scanned closure may reach `sorryAx`; and no `@[extern]` may
# appear outside the HaclStar FFI package. `module_prefixes` covers the whole
# first-party closure (Tls, TLS13, HaclStar) so that last check is a statement
# about the repository, not just this library.
#
# `allowed_axioms` is deliberately the bare standard three. The byte
# (de)composition identities in `Tls.Record.Laws` and `Tls.Handshake` are proved
# arithmetically rather than by `bv_decide`, so no generated LRAT-certificate
# axiom (`<lemma>._native.bv_decide.ax_1_5`) exists to allow. Introducing one —
# by reaching for `bv_decide` in a proof a headline theorem depends on — fails
# this audit immediately, which is the point.
lean_assurance_test(
    name = "tls_assurance",
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    allowed_extern_modules = ["HaclStar"],
    module_prefixes = [
        "HaclStar",
        "TLS13",
        "Tls",
    ],
    principal_theorems = [
        # Nonce non-reuse: no (traffic secret, nonce) pair is ever repeated by
        # the write side of a run, for either engine.
        "Tls.Record.WriteRun.nodup",
        "Tls.Client.run_nonce_nodup",
        "Tls.Client.feed_nonce_nodup",
        "Tls.Server.run_nonce_nodup",
        "Tls.Server.feed_nonce_nodup",
        "Tls.Record.nonceOf_inj",
        "Tls.Record.TrafficKeys.nonce_inj",
        "Tls.Record.sequenceBytes_inj",
        # Record layer: framing conserves bytes, and open inverts seal.
        "Tls.Record.decodeStep_conservation",
        "Tls.Record.decodeBuffered_conservation",
        "Tls.Record.Decoder.feed_conservation",
        "Tls.Record.Decoder.feed_residual",
        "Tls.Record.Decoder.feed_append",
        "Tls.Record.open_seal",
        "Tls.Record.decodeStep_seal_open",
        "Tls.Record.seal_nonce",
        # Handshake codec: a parsed ClientHello re-encodes to its own bytes, and
        # the body determines the message.
        "Tls.Handshake.parseClientHello_canonical",
        "Tls.Handshake.parseClientHello_canonical_of_offersTls13",
        "Tls.Handshake.parseClientHello_body_injective",
        "Tls.Handshake.parseExtensions_injective",
        "Tls.Handshake.decode_encoded",
        "Tls.Handshake.decode_frame",
        "Tls.Handshake.decodeOne_canonical",
        "Tls.Handshake.decode_canonical",
        "Tls.Handshake.takeMessage?_canonical",
        "Tls.Handshake.decodeOne_injective",
        "Tls.Handshake.takeMessage?_conservation",
        # Key schedule: the engines install the RFC 8446 §7.1 epochs, with the
        # RFC's parents, labels, contexts and lengths — structural refinement,
        # parametric over the opaque HKDF (see //TLS13:tls13_assurance for the
        # specification side).
        "Tls.Record.deriveTrafficKeys_spec",
        "Tls.Record.updateTrafficSecret_spec",
        "Tls.Record.TrafficKeys.update_spec",
        "Tls.Client.finishedVerifyData_spec",
        "Tls.Client.acceptServerHello_keySchedule",
        "Tls.Client.completeServerHandshake_keySchedule",
        "Tls.Client.processHandshakeBuffer_keySchedule",
        "Tls.Client.acceptKeyUpdate_keySchedule",
        "Tls.Server.finishedVerifyData_spec",
        "Tls.Server.completeClientHello_keySchedule",
        "Tls.Server.acceptKeyUpdate_keySchedule",
        # State machines: the transitions that define what "connected" means.
        "Tls.Client.completeServerHandshake_verified",
        "Tls.Client.acceptServerHello_transcript",
        "Tls.Client.acceptKeyUpdate_epoch",
        "Tls.Client.sealApplication_connected",
        "Tls.Client.feed_plaintext_connected",
        "Tls.Client.run_plaintext_connected",
        "Tls.Client.closeNotify_connected",
        "Tls.Client.feedWithFailure_closed",
        "Tls.Client.State.WellFormed.noReadKeys",
        "Tls.Client.run_wellFormed",
        "Tls.Server.acceptClientFinished_verified",
        "Tls.Server.sendHelloRetryRequest_messageHash",
        "Tls.Server.acceptKeyUpdate_epoch",
        "Tls.Server.checkRetryClientHello_body_eq",
        "Tls.Server.sealApplication_connected",
        "Tls.Server.feed_plaintext_connected",
        "Tls.Server.run_plaintext_connected",
        "Tls.Server.State.WellFormed.writeKeys",
        "Tls.Server.closeNotify_connected",
        "Tls.Server.feedWithFailure_closed",
        "Tls.Server.run_wellFormed",
    ],
    deps = [":tls"],
)
